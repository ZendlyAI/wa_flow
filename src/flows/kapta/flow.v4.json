                    "categoriesSelected": "${form.categoriesSelected}",
                    "categories": "${data.categories}",
                    "categoriesSize": "${data.categoriesSize}",
                    "categoryCounter": "${data.categoryCounter}",
                    "storeType": "${data.storeType}",
