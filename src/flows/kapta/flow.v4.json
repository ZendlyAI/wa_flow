{
  "routing_model": {
    "STORE": ["CATEGORIES", "CHANNEL"],
    "CHANNEL": ["CATEGORIES"],
    "CATEGORIES": ["MEDIA_ONE", "MEDIA_TWO", "MEDIA_THREE", "MEDIA_FOUR"],
    "MEDIA_ONE": ["MEDIA_TWO", "MEDIA_THREE", "MEDIA_FOUR"],
    "MEDIA_TWO": ["MEDIA_THREE", "MEDIA_FOUR"],
    "MEDIA_THREE": ["MEDIA_FOUR"]
  },
  "data_api_version": "3.0",
  "version": "7.1",
  "screens": [
    {
      "id": "STORE",
      "title": "Captura de datos",
      "data": {
        "storeName": {
          "type": "string",
          "__example__": "TIENDA EL CABRITO"
        },
        "storeAddress": {
          "type": "string",
          "__example__": "Calle Paz 123, Ciudad, País"
        },
        "flowToken": {
          "type": "object",
          "properties": {
            "userLocation": {
              "type": "object",
              "properties": {
                "latitude": { "type": "number" },
                "longitude": { "type": "number" }
              }
            },
            "conversationId": {
              "type": "string"
            }
          },
          "__example__": {
            "userLocation": {
              "latitude": 49.287857055664,
              "longitude": -123.12412261963
            },
            "conversationId": "conv_01JXGMQ38TEC4DX4CYJD0J6E2K"
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "store_form",
            "children": [
              {
                "type": "TextBody",
                "markdown": true,
                "text": ["**Nombre de la tienda**"],
                "visible": true
              },
              {
                "type": "TextInput",
                "required": true,
                "label": "Nombre de la tienda",
                "name": "storeName"
              },
              {
                "type": "TextArea",
                "label-variant": "large",
                "required": true,
                "label": "Dirección de la tienda",
                "name": "storeAddress"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "storeName": "${form.storeName}",
                    "storeAddress": "${form.storeAddress}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CHANNEL",
      "title": "Tipo de tienda",
      "data": {
        "storeName": {
          "type": "string",
          "__example__": "TIENDA EL CABRITO"
        },
        "storeAddress": {
          "type": "string",
          "__example__": "Calle Paz 123, Ciudad, País"
        },
        "flowToken": {
          "type": "object",
          "properties": {
            "userLocation": {
              "type": "object",
              "properties": {
                "latitude": { "type": "number" },
                "longitude": { "type": "number" }
              }
            },
            "conversationId": {
              "type": "string"
            }
          },
          "__example__": {
            "userLocation": {
              "latitude": 49.287857055664,
              "longitude": -123.12412261963
            },
            "conversationId": "conv_01JXGMQ38TEC4DX4CYJD0J6E2K"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "MODERNO",
              "title": "Moderno"
            },
            {
              "id": "TRADICIONAL",
              "title": "Tradicional"
            }
          ]
        },
        "modernTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "carulla"
            },
            {
              "id": "2",
              "title": "exito"
            }
          ]
        },
        "traditionalTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Tienda de barrio"
            },
            {
              "id": "2",
              "title": "Supermercado de barrio"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "store_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "storeChannel",
                "label": "Canal",
                "description": "Escoge el canal",
                "required": true,
                "data-source": "${data.channels}"
              },
              {
                "type": "If",
                "condition": "${form.storeChannel} == 'MODERNO'",
                "then": [
                  {
                    "type": "Dropdown",
                    "label": "Tipo de tienda",
                    "name": "modernType",
                    "required": true,
                    "data-source": "${data.modernTypes}",
                    "on-select-action": {
                      "name": "data_exchange",
                      "payload": {
                        "storeType": "${form.modernType}",
                        "storeChannel": "${form.storeChannel}",
                        "storeName": "${data.storeName}",
                        "flowtoken": "${data.storeName}",
                        "storeAddress": "${data.storeAddress}",
                        "userLocation": "${data.userLocation}",
                        "searchTerm": "${data.searchTerm}",
                        "suggestedStores": "${data.suggestedStores}",
                        "channels": "${data.channels}",
                        "modernTypes": "${data.modernTypes}",
                        "traditionalTypes": "${data.traditionalTypes}"
                      }
                    }
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.storeChannel} == 'TRADICIONAL'",
                "then": [
                  {
                    "type": "Dropdown",
                    "label": "Tipo de tienda",
                    "name": "traditionalType",
                    "required": true,
                    "data-source": "${data.traditionalTypes}",
                    "on-select-action": {
                      "name": "data_exchange",
                      "payload": {
                        "storeType": "${form.traditionalType}",
                        "storeChannel": "${form.storeChannel}",
                        "storeName": "${data.storeName}",
                        "flowtoken": "${data.storeName}",
                        "storeAddress": "${data.storeAddress}",
                        "userLocation": "${data.userLocation}",
                        "searchTerm": "${data.searchTerm}",
                        "suggestedStores": "${data.suggestedStores}",
                        "channels": "${data.channels}",
                        "modernTypes": "${data.modernTypes}",
                        "traditionalTypes": "${data.traditionalTypes}"
                      }
                    }
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "next": true,
                    "storeType": "${data.storeType}",
                    "storeChannel": "${form.storeChannel}",
                    "storeName": "${data.storeName}",
                    "flowtoken": "${data.storeName}",
                    "storeAddress": "${data.storeAddress}",
                    "userLocation": "${data.userLocation}",
                    "searchTerm": "${data.searchTerm}",
                    "suggestedStores": "${data.suggestedStores}",
                    "channels": "${data.channels}",
                    "modernTypes": "${data.modernTypes}",
                    "traditionalTypes": "${data.traditionalTypes}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
