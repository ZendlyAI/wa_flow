{
  "routing_model": {
    "STORE": ["CATEGORIES", "CHANNEL"],
    "CHANNEL": ["CATEGORIES"],
    "CATEGORIES": ["MEDIA"]
  },
  "data_api_version": "3.0",
  "version": "7.0",
  "screens": [
    {
      "id": "STORE",
      "title": "Captura de datos",
      "data": {
        "storeName": {
          "type": "string",
          "__example__": "TIENDA EL CABRITO"
        },
        "storeAddress": {
          "type": "string",
          "__example__": "Calle Paz 123, Ciudad, País"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "store_form",
            "children": [
              {
                "type": "TextBody",
                "markdown": true,
                "text": ["**Nombre de la tienda**"],
                "visible": true
              },
              {
                "type": "TextInput",
                "required": true,
                "label": "Nombre de la tienda",
                "name": "storeName"
              },
              {
                "type": "TextArea",
                "label-variant": "large",
                "required": true,
                "label": "Dirección de la tienda",
                "name": "storeAddress"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "storeName": "${form.storeName}",
                    "storeAddress": "${form.storeAddress}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CHANNEL",
      "title": "Tipo de tienda",
      "data": {
        "storeName": {
          "type": "string",
          "__example__": "TIENDA EL CABRITO"
        },
        "storeAddress": {
          "type": "string",
          "__example__": "Calle Paz 123, Ciudad, País"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "MODERNO",
              "title": "Moderno"
            },
            {
              "id": "TRADICIONAL",
              "title": "Tradicional"
            }
          ]
        },
        "modernTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "carulla"
            },
            {
              "id": "2",
              "title": "exito"
            }
          ]
        },
        "traditionalTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Tienda de barrio"
            },
            {
              "id": "2",
              "title": "Supermercado de barrio"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "store_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "storeChannel",
                "label": "Canal",
                "description": "Escoge el canal",
                "required": true,
                "data-source": "${data.channels}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "storeChannel": "${form.storeChannel}",
                    "storeName": "${data.storeName}",
                    "storeAddress": "${data.storeAddress}",
                    "userLocation": "${data.userLocation}",
                    "searchTerm": "${data.searchTerm}",
                    "suggestedStores": "${data.suggestedStores}",
                    "channels": "${data.channels}",
                    "modernTypes": "${data.modernTypes}",
                    "traditionalTypes": "${data.traditionalTypes}"
                  }
                }
              },
              {
                "type": "If",
                "condition": "${form.storeChannel} == 'MODERNO'",
                "then": [
                  {
                    "type": "Dropdown",
                    "label": "Tipo de tienda",
                    "name": "modernType",
                    "required": true,
                    "data-source": "${data.modernTypes}"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.storeChannel} == 'TRADICIONAL'",
                "then": [
                  {
                    "type": "Dropdown",
                    "label": "Tipo de tienda",
                    "name": "traditionalType",
                    "required": true,
                    "data-source": "${data.traditionalTypes}"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "next": true,
                    "modernType": "${form.modernType}",
                    "traditionalType": "${form.traditionalType}",
                    "storeChannel": "${data.storeChannel}",
                    "storeName": "${data.storeName}",
                    "storeAddress": "${data.storeAddress}",
                    "userLocation": "${data.userLocation}",
                    "searchTerm": "${data.searchTerm}",
                    "suggestedStores": "${data.suggestedStores}",
                    "channels": "${data.channels}",
                    "modernTypes": "${data.modernTypes}",
                    "traditionalTypes": "${data.traditionalTypes}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CATEGORIES",
      "title": "Categorias",
      "data": {
        "storeName": {
          "type": "string",
          "__example__": "TIENDA EL CABRITO"
        },
        "storeAddress": {
          "type": "string",
          "__example__": "Calle Paz 123, Ciudad, País"
        },
        "storeChannel": {
          "type": "string",
          "__example__": "MODERNO"
        },
        "storeType": {
          "type": "string",
          "__example__": "Tienda de barrio"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Bebidas sin alcohol",
              "description": "Jugos, gaseosas, aguas"
            },
            {
              "id": "2",
              "title": "Mascotas",
              "description": "Comida seca, húmeda, snacks"
            },
            {
              "id": "3",
              "title": "Snacks",
              "description": "Papas fritas, galletas, ponqués, chocolates, chicles"
            },
            {
              "id": "4",
              "title": "Cervezas y licores",
              "description": "Latas, botellas, packs"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "store_form",
            "children": [
              {
                "type": "CheckboxGroup",
                "name": "categoriesSelected",
                "min-selected-items": 3,
                "required": true,
                "label": "Agrega las categorias que trabajaste",
                "data-source": "${data.categories}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "categoriesSelected": "${form.categoriesSelected}",
                    "categories": "${data.categories}",
                    "categoriesSize": "${data.categoriesSize}",
                    "categoryCounter": "${data.categoryCounter}",
                    "modernType": "${data.modernType}",
                    "traditionalType": "${data.traditionalType}",
                    "storeChannel": "${data.storeChannel}",
                    "storeName": "${data.storeName}",
                    "storeAddress": "${data.storeAddress}",
                    "userLocation": "${data.userLocation}",
                    "searchTerm": "${data.searchTerm}",
                    "suggestedStores": "${data.suggestedStores}",
                    "channels": "${data.channels}",
                    "modernTypes": "${data.modernTypes}",
                    "traditionalTypes": "${data.traditionalTypes}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "MEDIA",
      "terminal": true,
      "success": true,
      "title": "Captura de datos",
      "data": {
        "storeName": {
          "type": "string",
          "__example__": "TIENDA EL CABRITO"
        },
        "storeAddress": {
          "type": "string",
          "__example__": "TIENDA EL CABRITO"
        },
        "storeChannel": {
          "type": "string",
          "__example__": "MODERNO"
        },
        "storeType": {
          "type": "string",
          "__example__": "Tienda del barrio"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Bebidas sin alcohol",
              "description": "Jugos, gaseosas, aguas"
            },
            {
              "id": "2",
              "title": "Mascotas",
              "description": "Comida seca, húmeda, snacks"
            },
            {
              "id": "3",
              "title": "Snacks",
              "description": "Papas fritas, galletas, ponqués, chocolates, chicles"
            },
            {
              "id": "4",
              "title": "Cervezas y licores",
              "description": "Latas, botellas, packs"
            }
          ]
        },
        "categoriesSelected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": ["1", "2"]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "store_form",
            "children": [
              {
                "type": "PhotoPicker",
                "name": "photo_picker",
                "label": "Subir fotos",
                "description": "Por favor sube fotos de las categorias",
                "photo-source": "camera_gallery",
                "min-uploaded-photos": 3,
                "max-uploaded-photos": 5,
                "max-file-size-kb": 25600
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "photo_picker": "${form.photo_picker}",
                    "categories": "${data.categories}",
                    "categoriesSize": "${data.categoriesSize}",
                    "categoryCounter": "${data.categoryCounter}",
                    "categoriesSelected": "${data.categoriesSelected}",
                    "modernType": "${data.modernType}",
                    "traditionalType": "${data.traditionalType}",
                    "storeChannel": "${data.storeChannel}",
                    "storeName": "${data.storeName}",
                    "storeAddress": "${data.storeAddress}",
                    "userLocation": "${data.userLocation}",
                    "searchTerm": "${data.searchTerm}",
                    "suggestedStores": "${data.suggestedStores}",
                    "channels": "${data.channels}",
                    "modernTypes": "${data.modernTypes}",
                    "traditionalTypes": "${data.traditionalTypes}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
