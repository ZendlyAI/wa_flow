{
  "name": "wa_flow_template",
  "version": "1.0.0",
  "description": "Endpoint for WhatsApp Flows https://developers.facebook.com/docs/whatsapp/flows",
  "main": "build/index.js",
  "scripts": {
    "start": "functions-framework --source=build/ --target=preLoad",
    "start:local": "npm run build && node build/index.js",
    "build": "rimraf ./build && tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy-reservation-flow": "gcloud functions deploy wa_flow_template-reservation-flow --gen2 --runtime=nodejs20 --region=us-central1 --source=. --entry-point=preLoad --trigger-http --env-vars-file=.env.yaml"
  },
  "author": "Gabriela Recinos <recinos.alejandra@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "axios": "^1.6.5",
    "crypto": "^1.0.1"
  }
}
