{
  "name": "wa_flow_template",
  "version": "1.0.0",
  "description": "Endpoint for WhatsApp Flows https://developers.facebook.com/docs/whatsapp/flows",
  "main": "build/index.js",
  "scripts": {
    "start": "npm run build:local && functions-framework --source=build/ --target=preLoad",
    "photoPicker": "npm run build:local && functions-framework --source=build/ --target=photoPicker",
    "image": "npm run build:local && functions-framework --source=build/ --target=getOrientationFromUrl",
    "start:local": "npm run build:local && node build/index.js",
    "build:local": "rimraf ./build && tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy": "gcloud functions deploy whatsapp-flow-zendly --gen2 --runtime=nodejs20 --region=us-central1 --source=. --entry-point=preLoad --trigger-http --env-vars-file=.env.yaml"
  },
  "author": "Gabriela Recinos <recinos.alejandra@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "rimraf": "4.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.3.0",
    "@google-cloud/storage": "7.16.0",
    "axios": "1.9.0",
    "crypto": "^1.0.1",
    "google-spreadsheet": "4.1.4",
    "googleapis": "150.0.1",
    "install": "0.13.0",
    "npm": "11.4.2",
    "openai": "5.3.0",
    "sharp": "0.34.2",
    "uuid": "11.1.0"
  }
}
